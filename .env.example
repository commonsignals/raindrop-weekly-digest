# Create a test token at https://app.raindrop.io/settings/integrations
# (create an app, then copy the "Test token" it generates for your own account)
RAINDROP_TOKEN=

# The collection to pull links from. Open the collection at raindrop.io/app
# and grab the number from the URL: https://app.raindrop.io/my/<COLLECTION_ID>
RAINDROP_COLLECTION_ID=

# Optional overrides
# DIGEST_DAYS=7
# DIGEST_OUTPUT_DIR=digests

# Optional: email the digest via SMTP. Leave any of these blank to skip emailing.
# Gmail / Google Workspace: host smtp.gmail.com, port 587, username is your full
# address, password is an App Password (not your login password) —
# see https://myaccount.google.com/apppasswords (requires 2-Step Verification).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
